# ==============================================================================
# Coranto - Environment Variables
# Copy this file to .env and configure the variables for local development or Vercel
# ==============================================================================

# Database (PostgreSQL - Neon, Supabase, Railway, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pool.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# Generate a secret using: `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="your-generated-auth-secret-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Inference Providers
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Groq API key (optional for fast fallback/primary inference): https://console.groq.com/
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"
LLM_PRIMARY="gemini" # or "groq"
TWO_TIER_JUDGE="false"

# Market & News Data Providers
# Finnhub Stock Market API: https://finnhub.io/
FINNHUB_API_KEY="your-finnhub-api-key"

# Tavily AI Search API: https://tavily.com/
TAVILY_API_KEY="your-tavily-api-key"
TAVILY_NEWS_DAYS="7"
TAVILY_MAX_RESULTS="5"

# MarketAux API (optional): https://www.marketaux.com/
MARKETAUX_API_KEY=""

# News Pipeline Settings
NEWS_PROVIDERS="tavily,finnhub"
NEWS_MOCK="false"

# Email Delivery (Resend)
# https://resend.com/
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Coranto Radar <onboarding@resend.dev>"
DIGEST_EMAIL="your-email@example.com"

# Web Push Notifications (Optional)
# Generate keys via: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
PUSH_MIN_SEVERITY="HIGH"

# Pipeline Concurrency & Tuning (Optional)
BATCH_SIZE="10"
PIPELINE_CONCURRENCY="3"
NEWS_CONCURRENCY="2"
LLM_CONCURRENCY="2"
LOG_LEVEL="info"
